---
import Subtitle from "../components/Subtitle.astro";
import ServiceCard from "../components/ServiceCard.astro";
---

<section class="bg-neutral-900 px-2 py-15 flex flex-col items-center">
    <Subtitle subtitle="Nuestros servicios" />
    <p class="text-neutral-300 mb-10">Soluciones eléctricas para cada necesidad</p>

    <section class="grid grid-cols-1 grid-rows-3 xs:grid-cols-2 md:grid-cols-3 sm:grid-rows-2 gap-3 max-w-5xl">
        <ServiceCard 
            class="bg-sky-100 text-sky-800"
            icon="home-bold" 
            title="Instalaciones residenciales" 
            description="Tableros eléctricos, circuitos, tomas y más para tu hogar." />
        <ServiceCard 
            class="bg-green-100 text-green-800"
            icon="lamp"
            title="Iluminación LED" 
            description="Montaje de sistemas de iluminación eficientes." />
        <ServiceCard
            class="bg-orange-100 text-yellow-800"
            icon="building" 
            title="Instalaciones comerciales" 
            description="Proyectos eléctricos para locales, oficinas y galpones." />
        <ServiceCard
            class="bg-purple-100 text-indigo-800"
            icon="camera"
            title="Cámaras y alarmas"
            description="Instalación de sistemas de seguridad y monitoreo." />
        <ServiceCard 
            class="bg-red-100 text-red-800"
            icon="seetings-bold"
            title="Reparaciones y Averías"
            description="Diagnóstico y solución de fallas eléctricas, cortocircuitos y problemas de cableado." />
        <ServiceCard
            class="bg-lime-100 text-lime-800"
            icon="smart-home"
            title="Automatización del Hogar"
            description="Instalación de timbres inteligentes, sensores de movimiento y portones eléctricos." />
    </section>
</section>