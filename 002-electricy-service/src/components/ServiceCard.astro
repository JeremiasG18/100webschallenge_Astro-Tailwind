---
import { Icon } from "astro-icon/components";

const { class: className, icon, title, description } = Astro.props;
---

<div class="p-6 max-w-75 bg-neutral-800 rounded-xl flex flex-col gap-y-3 border border-neutral-300/20">
    <span class:list={["p-3 rounded-xl w-fit", className]}>
        <Icon class={'w-7 h-7'} name={icon} />
    </span>
    <h3 class="text-neutral-200 font-medium">{title}</h3>
    <p class="text-neutral-300 text-sm">{description}</p>
</div>