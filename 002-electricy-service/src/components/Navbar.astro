---
import { Image } from 'astro:assets';

import logo from '../assets/logo-sinfondo.png';
import { Icon } from 'astro-icon/components';
---

<nav class="w-full py-2 flex justify-between items-center">
    <Image src={logo} alt=`Logo de la empresa` class:list={'w-20'} />
    
    <ul class="flex gap-x-5">
        <li><a href="#" class="text-neutral-200 p-3 rounded-sm hover:text-amber-300">Servicios</a></li>
        <li><a href="#" class="text-neutral-200 p-3 rounded-sm hover:text-amber-300">Portfolio</a></li>
        <li><a href="#" class="text-neutral-200 p-3 rounded-sm hover:text-amber-300">Contacto</a></li>
    </ul>

    <a class="text-neutral-200 p-3 rounded-md border border-neutral-50/70 flex gap-2 items-center hover:cursor-pointer hover:text-amber-300 hover:border-amber-300">
        <Icon name={'message'} class="w-5 h-5" />
        Solicitar cotización
    </a>
</nav>