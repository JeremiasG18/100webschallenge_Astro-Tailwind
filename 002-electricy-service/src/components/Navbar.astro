---
import { Image } from 'astro:assets';

import logo from '../assets/logo-sinfondo.png';
import { Icon } from 'astro-icon/components';
---

<nav class="w-full max-w-5xl p-2 flex justify-between items-center bg-primary">
    <div class="">
        <a href="./">
            <Image src={logo} alt='Logo de la empresa' class:list={'w-20'} />
        </a>
    </div>
    
    <button class="cursor-pointer md:invisible" id="toggle-btn" type="button">
        <Icon name={'open-menu'} class="w-10 h-10 p-2 text-neutral-50 hover:text-amber-300" id={'open-menu'} />

        <Icon name={'close-menu'} class="w-10 h-10 p-2 text-neutral-50 hover:text-amber-300 hidden" id={'close-menu'} />
    </button>

    <div class="bg-primary w-full p-4 flex flex-col items-center gap-y-10 absolute top-21 left-0 md:px-0 md:static md:visible md:flex-row" hidden id="navbar">
        <ul class="md:w-full flex flex-col justify-center gap-y-5 md:flex-row">
            <li><a href="#services" class="text-neutral-200 p-3 rounded-sm hover:text-amber-300">Servicios</a></li>
            <li><a href="#portfolio" class="text-neutral-200 p-3 rounded-sm hover:text-amber-300">Portafolio</a></li>
            <li><a href="#contact" class="text-neutral-200 p-3 rounded-sm hover:text-amber-300">Contacto</a></li>
        </ul>
    
        <a href="https://wa.me/5493704265311" target="_blank" class="text-neutral-200 p-3 rounded-md border border-neutral-50/70 flex gap-2 items-center whitespace-nowrap min-w-max hover:cursor-pointer hover:text-amber-300 hover:border-amber-300">
            <Icon name={'message'} class="w-5 h-5" />
            Solicitar cotización
        </a>
    </div>
</nav>