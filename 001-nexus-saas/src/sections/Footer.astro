---
import { Icon } from "astro-icon/components";
import FooterTitleLinks from "../components/FooterTitleLinks.astro";
import FooterLink from "../components/FooterLink.astro";
---

<footer class="py-25 px-4 xs:px-12 bg-primary">
    <div class="flex flex-col sm:flex-row gap-5 mb-7">
        <section class="mb-7 flex-1">
            <a href="./" class="font-secondary text-lemon text-[22px] tracking-[-0.5px] inline-block mb-3">Nexus</a>
            <p class="text-neutral-500">Infraestructura de datos para equipos modernos. Rápido, confiable, sin drama.</p>
        </section>
        <section class="flex flex-wrap xs:flex-nowrap justify-around gap-2 flex-2">
            <ul>
                <FooterTitleLinks title="PRODUCTO" />
                <FooterLink linkText="Características"/>
                <FooterLink linkText="Precios" />
                <FooterLink linkText="Cambios" />
                <FooterLink linkText="Estado" />
            </ul>
            <ul>
                <FooterTitleLinks title="EMPRESA" />
                <FooterLink linkText="Acerca de" />
                <FooterLink linkText="Blog" />
                <FooterLink linkText="Careers" />
                <FooterLink linkText="Prensa" />

            </ul>
            <ul>
                <FooterTitleLinks title="RECURSOS" />
                <FooterLink linkText="Documentación" />
                <FooterLink linkText="API Reference" />
                <FooterLink linkText="Comunidad" />
                <FooterLink linkText="Soporte" />
                
            </ul>
        </section>
    </div>
    <section class="border-t border-neutral-500/30 text-neutral-500 text-sm flex flex-wrap items-center gap-x-4 py-4 justify-between">
        <p class="mb-4">© 2025 Nexus Technologies Inc. · <a href="#">Privacidad</a> · <a href="#">Términos</a></p>
        <div class="flex gap-2">
            <a href="#" class="border border-neutral-500 rounded-sm p-0.5 text-2xl">
                <Icon name={'brand-x'} />
            </a>
            <a href="#" class="border border-neutral-500 rounded-sm p-0.5 text-2xl">
                <Icon name={'brand-linkedin'} />
            </a>
            <a href="#" class="border border-neutral-500 rounded-sm p-0.5 text-2xl">
                <Icon name={'brand-github'} />
            </a>
        </div>
    </section>
</footer>