---
import TextFunc from './code-editor/TextFunc.astro';
import Text from './code-editor/Text.astro';
import KeyWord from './code-editor/KeyWord.astro';

import MetricCard from './MetricCard.astro';
import TrafficLight from './TrafficLight.astro';
---

<section class="min-h-[calc(100dvh+79px)] max-h-auto flex flex-wrap justify-between items-center gap-15 px-4 py-10 xs:px-12">
    <div class="max-w-103 flex-1 xs:min-w-80">
        <span class="border border-lemon/25 text-lemon uppercase text-[12px] py-1.25 px-3.5 rounded-4xl bg-lemon/10 inline-flex items-center gap-2 mb-7 version">
            Nuevo — Pipeline AI v3.0
        </span>

        <h1 class="text-[64px] leading-17 font-secondary tracking-tight font-bold mb-7">
            <span class="text-neutral-50 not-italic">Tu data,</span><br>
            <em class="text-lemon">sin fricción.</em>
        </h1>

        <p class="text-olive-500 leading-7 mb-10">Nexus unifica todos tus flujos de datos en una plataforma inteligente. Sin ETL manual, sin código complejo. Solo insights en tiempo real.</p>

        <div class="flex flex-wrap gap-4 font-medium">
            <a href="#" class="bg-lemon py-3.5 px-8 rounded-sm hover:bg-lemon-hover transition ease-out">Probar gratis 14 días</a>
            <a href="#" class="py-3.5 px-6 text-neutral-400 rounded-sm border border-neutral-400/25 hover:border-neutral-50 hover:text-neutral-50 transition ease-out">▶ Ver demo</a>
        </div>
    </div>

    <div class="bg-tertiary max-w-150 flex-1 min-w-30 rounded-xl border border-neutral-700/50 p-7 xs:min-w-85">
        <div class="flex gap-x-1.25">
            <TrafficLight class="bg-[#ff5f56]" />
            <TrafficLight class="bg-[#ffbd2e]" />
            <TrafficLight class="bg-[#27c93f]" />
        </div>

        <code class="block overflow-x-auto">
            <ol class="list-decimal text-[#666] text-[13px] w-max mt-5 pl-9">
                    <li class="text-[#444] my-1.5">
                        // nexus.config.ts
                    </li>
                    <li class="my-1.5">
                        <KeyWord keyword="import" /> {'{'} <TextFunc textFunc="Pipeline"/> {'}'} <KeyWord keyword="from" /> <Text text="'@nexus/core'" />
                    </li>
                    <li class="my-1.5"></li>
                    <li class="my-1.5">
                        <KeyWord keyword="const" /> <TextFunc textFunc="flow" /> = <KeyWord keyword="new" /> <TextFunc textFunc="Pipeline" /> {'({'}
                    </li>
                    <li class="my-1.5">&nbsp source: <Text text="'postgres://prod'" /> ,</li>
                    <li class="my-1.5">&nbsp trasnform: <TextFunc textFunc="ai.infer" /> (),</li>
                    <li class="my-1.5">&nbsp sink: <Text text="'warehouse'" /></li>
                    <li class="my-1.5">{'})'}</li>
                </ol>
        </code>
        
        <div class="flex flex-wrap gap-3 mt-5">
            <MetricCard label="LATENCIA P99" val="12ms" delta="↓ 40% vs ayer" />
            <MetricCard label="REGISTROS / SEG" val="2.4M" delta="↑ en escala" />
        </div>
    </div>
</section>