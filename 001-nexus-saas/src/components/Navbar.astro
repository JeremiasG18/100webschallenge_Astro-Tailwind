---
---

<nav class="flex justify-between bg-primary items-center py-5 px-4 xs:px-12 border-b border-neutral-600/50 w-full top-0 sticky z-10">
    <a href="./" class="font-secondary text-lemon text-[22px] tracking-[-0.5px]">Nexus</a>
    <div class="flex-1 flex flex-row-reverse items-center gap-4 md:flex-row md:gap-0">
        <ul class="hidden flex-1 justify-center text-neutral-400 text-sm gap-9 p-1 md:flex" id="nav-links">
            <li><a href="#" class="hover:text-neutral-50 transition ease-out">Inicio</a></li>
            <li><a href="#" class="hover:text-neutral-50 transition ease-out">Producto</a></li>
            <li><a href="#" class="hover:text-neutral-50 transition ease-out">Precios</a></li>
            <li><a href="#" class="hover:text-neutral-50 transition ease-out">Nosotros</a></li>
            <li><a href="#" class="hover:text-neutral-50 transition ease-out">Contacto</a></li>
        </ul>
        <button class="flex items-center md:hidden" id="toggle-btn">
            <svg xmlns="http://www.w3.org/2000/svg" class="fill-neutral-400 hover:fill-neutral-50 transition ease-out" height="24px" viewBox="0 -960 960 960" width="24px"><path d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z"/></svg>
        </button>
        <a href="#" class="bg-lemon py-2.5 px-6 rounded-sm text-[14px] font-medium leading-4.5 hover:bg-lemon-hover transition ease-out">Empezar gratis</a>
    </div>
</nav>

<script>
    const toggleBtn = document.querySelector('#toggle-btn');
    const navLinks = document.querySelector('#nav-links');

    toggleBtn?.addEventListener('click', () => {
        let isOpen = navLinks?.classList.contains('show-links');

        isOpen ? navLinks?.classList.remove('show-links') : navLinks?.classList.add('show-links');
    });

    window.addEventListener('resize', () => {
        let isOpen = navLinks?.classList.contains('show-links');

        if (window.innerWidth.valueOf() >= 768) {
            if (isOpen) {
                navLinks?.classList.remove('show-links')
            }
        }
    })
</script>