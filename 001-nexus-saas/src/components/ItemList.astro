---
const { number, title, description } = Astro.props;
---

<li class="flex flex-row gap-5 border-y border-neutral-400/20 py-5">
    <span class="text-3xl text-neutral-500 font-secondary">{number}</span>
    <div>
        <h3 class="text-[16px] font-medium mb-2">{title}</h3>
        <p class="text-[14px] text-neutral-500">{description}</p>
    </div>
</li>